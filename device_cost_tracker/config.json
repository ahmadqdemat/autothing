{
  "name": "Device Power Cost Tracker",
  "version": "2.0.0",
  "slug": "device_cost_tracker",
  "description": "Track device runtime, energy consumption, and electricity costs. Writes metrics to InfluxDB.",
  "url": "https://github.com/ahmadqdemat/autothing",
  "arch": [
    "aarch64",
    "amd64",
    "armhf",
    "armv7",
    "i386"
  ],
  "init": false,
  "startup": "application",
  "boot": "auto",
  "ingress": true,
  "ingress_port": 8099,
  "panel_icon": "mdi:lightning-bolt-circle",
  "panel_title": "Power Tracker",
  "panel_admin": true,
  "ports": {
    "8099/tcp": null
  },
  "options": {
    "ha_token": "",
    "influx_url": "http://192.168.0.133:8086",
    "influx_username": "homeassistant",
    "influx_password": "",
    "influx_database": "homeassistant",
    "currency": "AED",
    "default_price_per_kwh": 0.62,
    "update_interval_sec": 60
  },
  "schema": {
    "ha_token": "str?",
    "influx_url": "str",
    "influx_username": "str",
    "influx_password": "str",
    "influx_database": "str",
    "currency": "str",
    "default_price_per_kwh": "float",
    "update_interval_sec": "int"
  },
  "homeassistant_api": true,
  "hassio_api": false,
  "auth_api": true,
  "map": [
    {
      "type": "data",
      "read_only": false
    }
  ]
}